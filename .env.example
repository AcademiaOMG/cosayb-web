# ── Backend ────────────────────────────────────────────────────────────────
# URL pública del API (la usa el navegador). En local, el API corre en :3000.
NEXT_PUBLIC_API_URL=http://localhost:3000
# URL del API para el proxy /api/auth del servidor de Next (opcional; por defecto NEXT_PUBLIC_API_URL).
API_URL=http://localhost:3000

# ── Sitio ──────────────────────────────────────────────────────────────────
# URL pública de este frontend (sitemap, robots, metadatos). En producción: https://cosayb.co
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3002

# Minutos de inactividad antes de cerrar la sesión (debe coincidir con el API).
NEXT_PUBLIC_SESSION_IDLE_MINUTES=120

# ── SaaS: facturación, notificaciones, soporte y métricas de plataforma ───
# mock = datos simulados en el navegador (demostración/desarrollo)
# real = llama al API (/api/v1/...), ver docs/RUNBOOK_WEB.md
# Sin esta variable: desarrollo = mock, producción = real.
NEXT_PUBLIC_SAAS_MODE=mock

# ── Monitoreo (opcional) ───────────────────────────────────────────────────
# Si se define, los errores no controlados se envían a Sentry. Vacío = desactivado.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_RELEASE=

# ── Pruebas E2E (opcional) ─────────────────────────────────────────────────
# E2E_BASE_URL=http://localhost:3002  (ver playwright.config.ts y tests/)
